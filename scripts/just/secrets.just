# ==============================================================================
# scripts/just/secrets.just
# Responsibility: Age key + SOPS encryption lifecycle management
#
# BEGINNER MAP (the whole surface in one screen — `just secrets-guide`
# prints it with scenario flows):
#
#   registry (the data)      secrets-add <alias> <rel-path>   register (3 layers at once)
#                            secrets-edit <alias> · secrets-remove <alias>
#                            secrets-show <alias> · secrets-declared · secrets-db
#   secrets (the values)     secret-set <alias> · secret-set-all
#                            secret-get <alias> · secret-edit <alias>
#                            secret-remove <alias> · secrets-list
#   keys (the decryptors)    key-show · key-destroy
#                            key-new-host · key-show-host
#                            key-add-host · key-install-host · key-remove
#                            key-rotate-user · key-rotate-host
#   rules (the policy)       .sops.yaml — rendered once by secrets-init,
#                            evolved by the key verbs (rules-init/reset/destroy)
#   keep-consistent          secrets-sync (re-encrypt onto rules)
#                            secrets-verify (audit) · secrets-status
#
# Layer architecture (each layer owns ONE question; no layer answers
# another layer's question — same discipline as a compiler pipeline):
#   ┌──────────────────────────────────────────────────────────────────┐
#   │  TMPL LAYER      docs/tmpl/sops/**                               │
#   │                  bootstrap BASELINE, dual render mode: user-only │
#   │                  (host lines stripped) or dual-key (rendered);   │
#   │                  generated once, never regenerated over an       │
#   │                  evolved file                                    │
#   ├──────────────────────────────────────────────────────────────────┤
#   │  KEY LAYER       user:  _secrets-keygen →                        │
#   │                        ~/.config/sops/age/keys.txt               │
#   │                  host:  key-new-host → delivery copy             │
#   │                        (repo-external) → remote server:          │
#   │                        /var/lib/sops-nix/key.txt / own host:     │
#   │                        key-install-host merges the identity      │
#   │                        into the local sops key file (age multi-  │
#   │                        identity) — sops-nix keyFile already      │
#   │                        reads it, zero nix changes                │
#   ├──────────────────────────────────────────────────────────────────┤
#   │  RULE LAYER      .sops.yaml = POLICY TRUTH + DISPATCH LAYER      │
#   │                  creation_rules decide recipients per path; keys:│
#   │                  aliases carry the domain payload (user_*/host_*)│
#   │                  bootstrap: tmpl → sed → guarded overwrite;      │
#   │                  evolution:  incremental verbs (key-add-host /   │
#   │                  key-remove / rotate) — regen refuses evolved    │
#   │                  files                                           │
#   ├──────────────────────────────────────────────────────────────────┤
#   │  REGISTRY        secrets/registry.toml = the alias table (DATA): │
#   │                  alias | dotted-key | prompt | transform.        │
#   │                  Owned by the CRUD verbs (secrets-add / -edit /  │
#   │                  -remove); every public verb is a thin pass      │
#   │                  over it — adding a secret is ONE command, never │
#   │                  a new recipe                                    │
#   │  DATABASE CACHE  secrets/.cache/secrets.db (sqlite, ignored):    │
#   │                  registry × shared.nix declarations × filesystem │
#   │                  state materialized by scripts/sh/secrets-db.py; │
#   │                  every query transparently refreshes on drift    │
#   ├──────────────────────────────────────────────────────────────────┤
#   │  CIPHER LAYER    secrets/chipr/** SOPS-encrypted                 │
#   │                  interactive input → sops encrypt → overwrite    │
#   ├──────────────────────────────────────────────────────────────────┤
#   │  ROTATE LAYER    scripts/sh/secrets-rotate.sh via just verbs     │
#   │                  secrets-verify / secrets-sync / key-rotate-*    │
#   │                  (rules are executed AS DATA — zero domain       │
#   │                  hardcoding)                                     │
#   └──────────────────────────────────────────────────────────────────┘
#
# Lifecycle state machine (see secrets-guide / docs/secrets/rotation.md):
#   EMPTY ──secrets-init──▶ USER_ONLY ──key-add-host──▶ USER+HOST
#   EMPTY ──secrets-init <alias> <age1…>──▶ USER+HOST   (direct dual-key)
#   USER+HOST ──key-remove──▶ USER_ONLY
#
# The EMPTY state is the repo's SHIPPED state (fresh clone): .sops.yaml
# and every blob are GENERATED by this flow and committed only after
# the user bootstraps them with their own keys (eval tolerates the
# empty tree — see lib/shared/shared/validate.nix).
#
# Where the host PRIVATE key lives (two branches, one delivery copy):
#   remote server : /var/lib/sops-nix/key.txt        (host-only machine)
#   own host      : merged into ~/.config/sops/age/keys.txt via
#                   key-install-host — a personal machine that also
#                   runs srv services (dev-on-demand) consumes BOTH domains;
#                   age identity files hold multiple keys natively, and
#                   sops-nix's keyFile already points there. The hardened
#                   srv policy (host-only recipients) and the independent
#                   recovery path both require this branch.
#
# Design principles:
#   - Data-driven: all secret paths read from shared.nix at runtime; the
#     alias→secret mapping lives in ONE registry DATA FILE
#     (secrets/registry.toml). Adding a new secret = ONE command
#     (`just secrets-add <alias> <rel-path>`) — it writes the registry
#     row, the template skeleton, and the shared.nix declaration (live +
#     template) together. No new recipe, no manual file surgery.
#
#   - Canonical substitution rule (SINGLE, position-agnostic — no special-cases):
#     shared.nix is a Nix module and stores secret rel-paths using Nix string
#     interpolation, e.g. "nixos/core/base/user/${username}/password". The real
#     username is bound once via `username = "<U>"` near the top of the file.
#     Because just reads shared.nix as plain text (grep), it sees the literal
#     "${username}" rather than the resolved value. We resolve it at the text
#     level with ONE bash parameter expansion, applied identically to every key:
#         needle='${username}'
#         TMPL_REL = "${REL//${needle}/__USERNAME__}"   # → template rel-path
#         RES_REL  = "${REL//${needle}/${U}}"           # → resolved secret rel-path
#     The substitution is global and literal, so it handles the username whether
#     it appears as a path segment (…/kilig/…) OR as an affix (redis-kilig) with
#     the SAME rule. There are no per-secret sed clauses and no special-case for
#     redis. This rule is defined ONCE in _secrets-paths and reused by every layer.
#
#   - Single resolver: _secrets-paths <key> is the ONLY function that maps a
#     dotted key in shared.nix to concrete filesystem locations. It emits
#     (template path, resolved rel-path, username) so plan/chipr layers always
#     agree on which file is which. No recipe duplicates the grep+resolve logic.
#
#   - Single username source: _secrets-username is the ONLY function that
#     parses the username binding from shared.nix. Every recipe that needs U
#     (and not full paths) goes through it.
#
#   - Generic encrypt writer: _secrets-encrypt handles all secrets; the per-
#     secret differences (prompt label, transform) live in the registry rows,
#     not in code.
#
#   - _secrets-mkdir iterates all nixos.* secret values in shared.nix
#     (resolved via the canonical rule) to create directories — no path list
#     to maintain.
#
#   - Generate, don't mutate: overwrite, never in-place patch.
#   - plan / chipr fully separated — different lifecycle, different audience.
#   - secrets-init only sets up infrastructure; no interactive prompts.
#   - Destroy operations are granular.
#
# Information source (all stages read from shared.nix):
#   BOOTSTRAP      shared.nix must exist; _secrets-mkdir and
#                  _secrets-write-rules read it
#   POST-BOOTSTRAP paths auto-derived from shared.nix secrets.* values at runtime
#
# NOTE: imported by justfile; all paths use ROOT (defined in root justfile).
#
# Template directory mirrors the secret path hierarchy under docs/tmpl/sops/:
#   nixos/core/base/user/__USERNAME__/password.yaml
#   nixos/core/base/nix/users/__USERNAME__/github/access-token.yaml
#   nixos/core/srv/db/{mongodb,mysql,postgresql,redis}/users/.../password.yaml
#   sops-rules.yaml.tmpl
#
# Template placeholder convention (single, like __USERNAME__):
#   __SECRET_VALUE__  — where the typed secret lands in a template YAML.
#
# YAML leaf-key convention (required by sops-nix path lookup):
#   sops-nix splits a secret key on "/" and walks the YAML hierarchy. The leaf
#   key in the template MUST equal the last path segment.
#   Example: key "nixos/core/base/nix/users/kilig/github/access-token"
#            → YAML leaf key: "access-token"  (singular — matches path segment)
#            → VALUE may be:  "access-tokens = github.com=TOKEN"  (nix.conf line)
# ==============================================================================

SECRETS_PATH       := ROOT          / "secrets"
SECRETS_CHIPR_PATH := SECRETS_PATH  / "chipr"
SECRETS_PLAN_PATH  := SECRETS_PATH  / "plan"
SECRETS_TMPL_PATH  := ROOT          / "docs" / "tmpl" / "sops"
DOT_SOPS_FILENAME  := ROOT          / ".sops.yaml"
SECRETS_KEYS_PATH  := "$HOME/.config/sops/age"
SECRETS_KEYFILE    := SECRETS_KEYS_PATH / "keys.txt"
SHARED_NIX_PATH    := ROOT          / "shared.nix"


# ==============================================================================
# GUIDE — the lifecycle entry point
# ==============================================================================

# Print the secrets lifecycle map: state machine, three-object verb map,
# scenario flows (day-one / dual-key on one machine / add a server /
# rotate). Start here — every other recipe is one verb in it.
[group('secrets')]
secrets-guide:
    @echo ""
    @echo "secrets — lifecycle map (start here)"
    @echo ""
    @echo "state machine:"
    @echo "  EMPTY ──secrets-init──▶ USER_ONLY ──key-add-host──▶ USER+HOST"
    @echo "  EMPTY ──secrets-init <alias> <age1…>──▶ USER+HOST   (direct dual-key)"
    @echo "  USER+HOST ──key-remove──▶ USER_ONLY (then secrets-sync)"
    @echo ""
    @echo "three objects, one map each:"
    @echo "  secrets (the values)     secret-set <alias>   interactive encrypt (upsert)"
    @echo "                           secret-set-all       every declared secret, in order"
    @echo "                           secret-get <alias>   decrypt + print"
    @echo "                           secret-edit <alias>  decrypt → $EDITOR → re-encrypt"
    @echo "                           secret-remove <alias> destroy one blob"
    @echo "                           secrets-list         alias table × state"
    @echo "  keys (the decryptors)    key-show             your user age public key"
    @echo "                           key-new-host <alias> keypair (outside the repo)"
    @echo "                           key-add-host        wire a host pubkey into the rules"
    @echo "                           key-install-host    host identity onto THIS machine"
    @echo "                           key-remove <alias>  revoke from the rules"
    @echo "                           key-rotate-user/host <age1…>  guided rotation"
    @echo "  rules (the policy)       .sops.yaml — rendered once by secrets-init"
    @echo "                           (docs/tmpl/sops/sops-rules.yaml.tmpl), then"
    @echo "                           evolved by the key verbs — rules-init/reset/destroy"
    @echo "  keep-consistent          secrets-sync   re-encrypt blobs onto the rules"
    @echo "                           secrets-verify  hierarchy audit (CI runs it too)"
    @echo "                           secrets-status keys + identities + rules + blobs"
    @echo ""
    @echo "where private keys live:"
    @echo "  user key  ~/.config/sops/age/keys.txt   (personal machines — BACK IT UP)"
    @echo "  host key  delivery copy → /var/lib/sops-nix/key.txt  (servers)"
    @echo "            or key-install-host → merged into the local key file"
    @echo "            (own host that also runs srv services)"
    @echo ""
    @echo "scenario 1 — personal machine, day one:"
    @echo "  just init <username>                 # shared.nix + hardware.nix + secrets infra"
    @echo "  just secret-set-all                  # type each secret once (encrypted on entry)"
    @echo "  just secrets-verify                  # expect all green"
    @echo ""
    @echo "scenario 2 — personal machine that ALSO runs srv services (dual key, one machine):"
    @echo "  just key-new-host <alias>             # host keypair (outside the repo)"
    @echo "  just init <username> <alias> <age1…>   # EMPTY → USER+HOST directly"
    @echo "  just secret-set-all"
    @echo "  just key-install-host <alias>         # host identity onto THIS machine"
    @echo "  just secrets-verify"
    @echo ""
    @echo "scenario 3 — add a server later (already bootstrapped):"
    @echo "  just key-new-host <alias>"
    @echo "  just key-add-host <alias> <age1…>     # pubkey into the rules (srv domain)"
    @echo "  just secrets-sync                     # re-encrypt blobs onto the host key"
    @echo "  # deliver host-<alias>.age → server:/var/lib/sops-nix/key.txt (chmod 400),"
    @echo "  # then shred the delivery copy"
    @echo ""
    @echo "scenario 4 — rotate keys (guided):"
    @echo "  just key-rotate-user <age1…>          # 3 steps"
    @echo "  just key-rotate-host <age1…>          # 4 steps (add-then-revoke)"
    @echo ""
    @echo "adding a secret = ONE command (the three layers are written together):"
    @echo "  just secrets-add <alias> <rel-path> [prompt] [transform]"
    @echo "    e.g. just secrets-add cachix-token nixos/core/base/nix/cachix/auth-token \"Cachix auth token\""
    @echo "    writes: registry row (secrets/registry.toml) + template skeleton"
    @echo "            (docs/tmpl/sops/…) + declaration (shared.nix + tmpl),"
    @echo "            then re-syncs the database cache. Refuses paths no sops"
    @echo "            rule covers (plaintext-risk class)."
    @echo ""
    @echo "audit: just secrets-status · just secrets-list · just secrets-show <alias>"
    @echo "       just secrets-declared (config-truth ↔ registry drift view)"
    @echo "runbook: docs/secrets/rotation.md"
    @echo ""


# ==============================================================================
# Init (BOOTSTRAP)
# ==============================================================================

# Init sops infra: dirs + user age key + .sops.yaml baseline rules.
#
#   just secrets-init                    → user-only baseline (USER_ONLY)
#   just secrets-init <alias> <age1…>     → direct dual-key (USER+HOST)
#
# The host material comes from `just key-new-host <alias>` (generate the
# keypair first, then pass the printed pubkey here). Both paths land in
# the same state the incremental verbs would reach — the state machine
# simply skips a hop when the material is already at hand.
[group('secrets')]
secrets-init host_alias="" host_pubkey="":
    @just _assert-shared
    @just _secrets-mkdir
    @just _secrets-keygen
    @just _secrets-write-rules false "{{host_alias}}" "{{host_pubkey}}"

# Init sops infra and also generate all plaintext template instances
# (secrets/plan/** — local reference copies, never committed).
[group('secrets')]
secrets-init-with-plan:
    @just secrets-init
    @just secrets-plan-create


# ==============================================================================
# KEY LAYER — user key
# ==============================================================================

# Print the current user age public key (what other machines need to
# grant you decrypt access — safe to share, it is public by design).
#
# The USER key is the FIRST identity of the local key file (the one
# _secrets-keygen created it with). Own-host machines carry additional
# identities there (host keys merged by key-install-host) — they are
# listed below a separator so they can never be mistaken for the user
# key when shared.
[group('keys')]
key-show:
    #!/usr/bin/env bash
    set -euo pipefail
    mapfile -t KEYS < <(age-keygen -y "{{SECRETS_KEYFILE}}")
    [[ -n "${KEYS[0]:-}" ]] || { echo "Error: no identity found in {{SECRETS_KEYFILE}}" >&2; exit 1; }
    echo "${KEYS[0]}"
    if (( ${#KEYS[@]} > 1 )); then
        echo "# additional local identities (NOT your user key):"
        printf '%s\n' "${KEYS[@]:1}"
    fi

# Destroy the user age key file (irreversible — every file it decrypts
# becomes unreadable on this machine; blobs stay intact in the repo).
[group('keys')]
key-destroy:
    @rm -rf {{SECRETS_KEYS_PATH}}
    @echo "Destroyed age key at {{SECRETS_KEYS_PATH}}"


# ==============================================================================
# KEY LAYER — HOST keys (dual-key hierarchy)
# ==============================================================================
# Host keys decrypt the srv domain. They are generated OUTSIDE the repo
# (delivery copy), the public key is wired into .sops.yaml, and the private
# key ends up exactly once on the target host at /var/lib/sops-nix/key.txt.
# Aliases in .sops.yaml carry the domain payload: host_<name> / user_<name>.

# Generate a host keypair (delivery copy, never inside the repo).
# Prints the public key + the exact commands to run next.
[group('keys')]
key-new-host alias dest="":
    #!/usr/bin/env bash
    set -euo pipefail
    A="{{alias}}"
    [[ "${A}" =~ ^[a-z0-9][a-z0-9_-]*$ ]] || { echo "Error: alias must match [a-z0-9][a-z0-9_-]* (got '${A}')" >&2; exit 1; }
    if [[ -n "{{dest}}" ]]; then
        DIR="{{dest}}"
    else
        DIR="${XDG_DOWNLOAD_DIR:-$HOME/Downloads}"
        [[ -d "${DIR}" ]] || DIR="/tmp"
    fi
    KEY="${DIR}/host-${A}.age"
    [[ ! -f "${KEY}" ]] || { echo "Refusing: ${KEY} exists — a private key is unrecoverable, never overwrite." >&2; exit 1; }
    age-keygen -o "${KEY}" 2>/dev/null
    chmod 400 "${KEY}"
    PUB="$(age-keygen -y "${KEY}")"
    echo "Host keypair generated (delivery copy, outside the repo):"
    echo "  private : ${KEY}   (chmod 400)"
    echo "  public  : ${PUB}"
    echo
    echo "Next (from the repo root):"
    echo "  PRE-BOOTSTRAP  (no .sops.yaml yet — direct dual-key):"
    echo "    just secrets-init ${A} ${PUB}    # or init-time: just init <user> ${A} ${PUB}"
    echo "  POST-BOOTSTRAP (.sops.yaml already exists — incremental):"
    echo "    1. just key-add-host ${A} ${PUB}"
    echo "    2. just secrets-sync"
    echo "  Land the private key — pick ONE branch:"
    echo "    remote server : deliver ${KEY} → /var/lib/sops-nix/key.txt (chmod 400),"
    echo "                   then shred the delivery copy: shred -u \"${KEY}\""
    echo "    this machine  : just key-install-host ${A}   (own host — personal"
    echo "                   machine that also runs srv services; identity merges"
    echo "                   into the local sops key file, then shred the copy)"

# Print the public key of a host delivery copy.
[group('keys')]
key-show-host alias src="":
    #!/usr/bin/env bash
    set -euo pipefail
    A="{{alias}}"
    if [[ -n "{{src}}" ]]; then
        KEY="{{src}}"
    else
        KEY="${XDG_DOWNLOAD_DIR:-$HOME/Downloads}/host-${A}.age"
        [[ -f "${KEY}" ]] || KEY="/tmp/host-${A}.age"
    fi
    [[ -f "${KEY}" ]] || { echo "Error: host-${A}.age not found in ~/Downloads, /tmp or <src>" >&2; exit 1; }
    age-keygen -y "${KEY}"

# Install a host key onto THIS machine (own-host dual-key branch).
#
# A personal machine that also runs srv services (dev-on-demand db
# profile) is a consumer of BOTH domains: the user key decrypts the user
# domain, and while the srv key group still carries the user key one key
# suffices — but the hardened srv policy (recipients rotated to host-only)
# and the independent recovery path (user key lost/compromised on other
# machines) both require the host identity to be present HERE. age
# identity files hold multiple keys natively (one AGE-SECRET-KEY-1 line per
# identity; age tries each against every stanza), and sops-nix's keyFile
# already reads the local sops key file — merge, don't duplicate
# infrastructure.
#
# Idempotent: skips when the exact identity (secret-key line) is already
# installed. After install the delivery copy is redundant on this machine
# — shred it (the identity now lives in the key file).
[group('keys')]
key-install-host alias src="":
    #!/usr/bin/env bash
    set -euo pipefail
    A="{{alias}}"
    [[ "${A}" =~ ^[a-z0-9][a-z0-9_-]*$ ]] || { echo "Error: alias must match [a-z0-9][a-z0-9_-]* (got '${A}')" >&2; exit 1; }
    if [[ -n "{{src}}" ]]; then
        KEY="{{src}}"
    else
        KEY="${XDG_DOWNLOAD_DIR:-$HOME/Downloads}/host-${A}.age"
        [[ -f "${KEY}" ]] || KEY="/tmp/host-${A}.age"
    fi
    [[ -f "${KEY}" ]] || { echo "Error: host-${A}.age not found in ~/Downloads, /tmp or <src> — generate it first: just key-new-host ${A}" >&2; exit 1; }
    DEST="{{SECRETS_KEYFILE}}"
    [[ -f "${DEST}" ]] || { echo "Error: ${DEST} missing — run: just secrets-init" >&2; exit 1; }
    ID="$(grep -m1 '^AGE-SECRET-KEY-1' "${KEY}" || true)"
    [[ -n "${ID}" ]] || { echo "Error: no AGE-SECRET-KEY-1 line in ${KEY} — not a valid age identity file" >&2; exit 1; }
    if grep -qF "${ID}" "${DEST}"; then
        echo "Skip: host key '${A}' is already installed in ${DEST}"
    else
        # Atomic append: write to a sibling temp file, then mv into place so a
        # mid-write failure never truncates the key file (the user key inside
        # it may be the only copy on this machine).
        TMP="$(mktemp "${DEST}.XXXXXX")"
        cat "${DEST}" > "${TMP}"
        printf '\n# host_%s — installed locally (own-host dual-key, see secrets-guide)\n%s\n' "${A}" "${ID}" >> "${TMP}"
        chmod 400 "${TMP}"
        mv -f "${TMP}" "${DEST}"
        echo "Installed host key '${A}' into ${DEST}"
    fi
    echo
    echo "Local identities now held by this machine (age-keygen -y lists all):"
    age-keygen -y "${DEST}" | nl
    echo
    echo "Next:"
    echo "  - verify both domains decrypt: just secret-get postgresql   (srv)"
    echo "  - this machine now holds the identity — shred the delivery copy:"
    echo "      shred -u \"${KEY}\""

# Register a host public key into the .sops.yaml hierarchy: appends the
# key alias to keys: and the group reference to the target domain rule's
# key group (default domain "srv" — the only dual-key domain). Idempotent
# refusal on duplicate alias or duplicate pubkey. Follow with
# secrets-sync to re-encrypt existing blobs.
[group('keys')]
key-add-host alias pubkey domain="srv":
    #!/usr/bin/env bash
    set -euo pipefail
    A="{{alias}}"
    [[ "${A}" =~ ^[a-z0-9][a-z0-9_-]*$ ]] || { echo "Error: alias must match [a-z0-9][a-z0-9_-]* (got '${A}')" >&2; exit 1; }
    [[ "{{pubkey}}" =~ ^age1[0-9a-z]+$ ]] || { echo "Error: pubkey must be an age1… public key" >&2; exit 1; }
    CONFIG="{{DOT_SOPS_FILENAME}}"
    [[ -f "${CONFIG}" ]] || { echo "Error: ${CONFIG} missing — run: just secrets-init" >&2; exit 1; }
    grep -q "&host_${A} " "${CONFIG}" && { echo "Refusing: key alias host_${A} already exists in ${CONFIG}" >&2; exit 1; }
    grep -q "{{pubkey}}" "${CONFIG}" && { echo "Refusing: pubkey {{pubkey}} already registered in ${CONFIG}" >&2; exit 1; }
    DOM="/core/{{domain}}/"
    grep -q -- "${DOM}" "${CONFIG}" || { echo "Error: no creation_rule matches ${DOM} — check the domain ({{domain}})" >&2; exit 1; }
    TMP="$(mktemp "${CONFIG}.XXXXXX")"
    awk -v keyline="  - &host_${A} {{pubkey}}" \
        -v dom="${DOM}" -v refalias="host_${A}" '
      /^creation_rules:/ && !done { print keyline; done = 1 }
      {
        print
        if (!in_target && $0 ~ /- path_regex:/ && index($0, dom) > 0) in_target = 1
        else if (in_target && $0 ~ /^[ \t]*-[ \t]*age:/) {
          match($0, /^[ \t]*/)
          print substr($0, 1, RLENGTH) "    - *" refalias
          in_target = 0
        }
      }
    ' "${CONFIG}" > "${TMP}"
    grep -q "&host_${A} " "${TMP}" || { echo "Error: keys: insertion failed" >&2; rm -f "${TMP}"; exit 1; }
    grep -q -- "- \*host_${A}" "${TMP}" || { echo "Error: key_groups insertion failed (no - age: under the ${DOM} rule?)" >&2; rm -f "${TMP}"; exit 1; }
    mv -f "${TMP}" "${CONFIG}"
    echo "Registered host_${A} → {{domain}} domain in ${CONFIG}"
    echo "Next: just secrets-sync   # re-encrypt blobs onto the host key"

# Revoke a key from the .sops.yaml hierarchy (removes the keys: line and
# every key_groups reference). Works for host_* and user_* aliases alike.
# Old ciphertexts stay readable by the revoked key until re-encryption —
# always follow with secrets-sync.
[group('keys')]
key-remove alias:
    #!/usr/bin/env bash
    set -euo pipefail
    A="{{alias}}"
    CONFIG="{{DOT_SOPS_FILENAME}}"
    [[ -f "${CONFIG}" ]] || { echo "Error: ${CONFIG} missing" >&2; exit 1; }
    # Accept both the full alias (host_lab / user_kilig) and the short form
    # every other key verb uses ('lab'): resolve host_<name> then user_<name>.
    if ! grep -q "&${A} " "${CONFIG}"; then
        FOUND=""
        for CAND in "host_${A}" "user_${A}"; do
            if grep -q "&${CAND} " "${CONFIG}"; then A="${CAND}"; FOUND=1; break; fi
        done
        [[ -n "${FOUND}" ]] || { echo "Error: key alias '${A}' (nor host_${A}/user_${A}) found in ${CONFIG}" >&2; exit 1; }
    fi
    TMP="$(mktemp "${CONFIG}.XXXXXX")"
    awk -v def="&${A} " -v ref="- \*${A}$" '
      index($0, def) > 0 { next }
      $0 ~ ref { next }
      { print }
    ' "${CONFIG}" > "${TMP}"
    grep -q "&${A} " "${TMP}" && { echo "Error: removal failed" >&2; rm -f "${TMP}"; exit 1; }
    mv -f "${TMP}" "${CONFIG}"
    echo "Revoked key '${A}' from ${CONFIG}"
    echo "Next: just secrets-sync   # re-encrypt blobs without the revoked key"


# ==============================================================================
# RULE LAYER — .sops.yaml management
# ==============================================================================
# .sops.yaml is the POLICY TRUTH for key distribution after bootstrap:
# host keys and rotations are incremental edits. Regen therefore REFUSES to
# overwrite an evolved file — the deliberate reset lives in rules-reset.

# Regenerate .sops.yaml from the bootstrap baseline template — only when
# it does not exist yet. Refuses on an evolved file: key evolution goes
# through the lifecycle verbs (see secrets-guide). For a deliberate
# hierarchy reset use rules-reset.
[group('rules')]
rules-init:
    #!/usr/bin/env bash
    set -euo pipefail
    DEST="{{DOT_SOPS_FILENAME}}"
    if [[ -f "${DEST}" ]]; then
        echo "Refusing: ${DEST} exists and carries the live key hierarchy." >&2
        echo "  - add / rotate keys : just secrets-guide" >&2
        echo "  - deliberate reset  : just rules-reset" >&2
        exit 1
    fi
    exec just _secrets-write-rules

# Hard hierarchy reset: regenerate .sops.yaml from the baseline template,
# overwriting the evolved policy truth (host keys and rotations are lost).
[group('rules')]
rules-reset:
    #!/usr/bin/env bash
    set -euo pipefail
    DEST="{{DOT_SOPS_FILENAME}}"
    echo "Warning: resetting ${DEST} to the user-only baseline —"
    echo "host keys and rotations are lost. Refusing to run silently."
    exec just _secrets-write-rules true

# Delete .sops.yaml (all layers re-encrypt on next init).
[group('rules')]
rules-destroy:
    @rm -f {{DOT_SOPS_FILENAME}}
    @echo "Destroyed {{DOT_SOPS_FILENAME}} (all layers re-encrypt on next init)"


# ==============================================================================
# PLAIN LAYER — plaintext template instances (plan)
# ==============================================================================
# Local-only reference copies of the templates (username substituted),
# useful to eyeball the YAML shape before typing real secrets.
# secrets/plan/** is gitignored — plaintext never enters the repo.

# Generate all plaintext template instances (reference copies) —
# registry-driven: the hardcoded key list this recipe used to carry was
# the coupling the R27 refactor removed (the registry is the single row
# source now; adding a secret needs no edit here).
[group('secrets')]
secrets-plan-create:
    #!/usr/bin/env bash
    set -euo pipefail
    just _assert-shared
    mapfile -t KEYS < <(just _secrets-registry | cut -d'|' -f2)
    for KEY in "${KEYS[@]}"; do
        just _secrets-plan-gen "${KEY}"
    done
    echo "All plan instances created under {{SECRETS_PLAN_PATH}}"

# Delete all plaintext template instances.
[group('secrets')]
secrets-plan-destroy:
    @rm -rf {{SECRETS_PLAN_PATH}}
    @echo "Destroyed {{SECRETS_PLAN_PATH}}"


# ==============================================================================
# REGISTRY LAYER — data-driven CRUD (R27)
# ==============================================================================
# The alias table lives in secrets/registry.toml (DATA). These verbs own
# it through scripts/sh/secrets-db.py, which also writes the template
# skeleton + the shared.nix declaration (live + template kept equivalent)
# and materializes the join into secrets/.cache/secrets.db (sqlite cache,
# git-ignored, transparently refreshed on any input drift).

# Register a new secret end-to-end: registry row + template skeleton +
# shared.nix/tmpl declaration, in one command. The dotted key is derived
# canonically from the path (dots for slashes, ${username} segments
# skipped). Refuses paths no .sops.yaml rule covers (plaintext-risk class)
# and aliases that already exist.
#   just secrets-add cachix-token nixos/core/base/nix/cachix/auth-token "Cachix auth token"
[group('secrets')]
secrets-add alias rel prompt="" transform="plain":
    @python3 "{{ROOT}}/scripts/sh/secrets-db.py" add {{quote(alias)}} {{quote(rel)}} {{quote(prompt)}} {{quote(transform)}}

# Retire a secret: registry row + template skeleton + declaration are
# removed together. REFUSES while the encrypted blob still exists
# (destroy it first: `just secret-remove <alias>` — the blob is the live
# value, this verb is the retirement of the SHAPE).
[group('secrets')]
secrets-remove alias:
    @python3 "{{ROOT}}/scripts/sh/secrets-db.py" remove {{quote(alias)}}

# Update a registry row's operator UX: prompt label and/or transform
# (plain | mkpasswd). Empty arguments keep the current value.
#   just secrets-edit postgresql "PostgreSQL (dev) password"
[group('secrets')]
secrets-edit alias prompt="" transform="":
    @python3 "{{ROOT}}/scripts/sh/secrets-db.py" edit {{quote(alias)}} {{quote(prompt)}} {{quote(transform)}}

# The one-secret dossier — everything the operator may need to see
# WITHOUT touching any file by hand (the no-accidents display layer):
# registry row, resolved paths (template/blob/plan), declaration,
# leaf key, covering sops rule, blob size/mtime and its recipients.
# Decryption stays an explicit separate verb (`secret-get`).
#   just secrets-show postgresql
[group('secrets')]
secrets-show alias:
    @python3 "{{ROOT}}/scripts/sh/secrets-db.py" q show {{quote(alias)}}

# Config-truth ↔ registry drift view: every shared.nix declaration ×
# registry membership × blob state. Answers "what does the config
# declare that the just surface does not cover" in one screen.
[group('secrets')]
secrets-declared:
    @python3 "{{ROOT}}/scripts/sh/secrets-db.py" q declared

# Database cache state: built_at, input fingerprint, row/declaration/blob
# counts. The cache is secrets/.cache/secrets.db (sqlite, git-ignored);
# queries refresh it transparently — this verb is inspection, not a chore.
[group('secrets')]
secrets-db:
    @python3 "{{ROOT}}/scripts/sh/secrets-db.py" q info

# Force a cache rebuild (after hand edits to registry.toml / shared.nix,
# or when a query's transparent refresh looks stale).
[group('secrets')]
secrets-db-sync:
    @python3 "{{ROOT}}/scripts/sh/secrets-db.py" sync


# ==============================================================================
# CIPHER LAYER — encrypt / decrypt / destroy (registry-driven)
# ==============================================================================
# Every public verb resolves its alias through _secrets-registry (DATA)
# and delegates to ONE generic writer/reader. No per-secret recipes.

# Interactive encrypt (upsert): type the value once, it lands encrypted.
#   just secret-set postgresql
[group('secrets')]
secret-set alias:
    #!/usr/bin/env bash
    set -euo pipefail
    ROW="$(just _secrets-row "{{alias}}")" || exit 1
    IFS='|' read -r _ KEY PROMPT TRANSFORM <<< "${ROW}"
    exec just _secrets-encrypt "${KEY}" "${PROMPT}" "${TRANSFORM:-plain}"

# Interactive encrypt of every declared secret, in registry order.
#
# stdin discipline: the registry is consumed by mapfile BEFORE the loop. A
# `done < <(registry)` redirection on the loop would be inherited by every
# child in the body (bash: a compound-command redirection is the body's
# stdin), so the nested interactive `_secrets-encrypt` would swallow
# registry rows instead of the typed password — "confirmation mismatch"
# on the first secret no matter what is typed. mapfile keeps the loop
# body on the CALLER's stdin (the terminal the passwords are typed into).
[group('secrets')]
secret-set-all:
    #!/usr/bin/env bash
    set -euo pipefail
    just _assert-shared
    mapfile -t ROWS < <(just _secrets-registry)
    for ROW in "${ROWS[@]}"; do
        IFS='|' read -r _ KEY PROMPT TRANSFORM <<< "${ROW}"
        just _secrets-encrypt "${KEY}" "${PROMPT}" "${TRANSFORM:-plain}" || exit 1
    done

# Decrypt and print one secret.   just secret-get postgresql
[group('secrets')]
secret-get alias:
    #!/usr/bin/env bash
    set -euo pipefail
    ROW="$(just _secrets-row "{{alias}}")" || exit 1
    IFS='|' read -r _ KEY _ _ <<< "${ROW}"
    exec just _secrets-decrypt "${KEY}"

# Decrypt into $EDITOR, re-encrypt on save (sops edit).
#   just secret-edit postgresql
[group('secrets')]
secret-edit alias:
    #!/usr/bin/env bash
    set -euo pipefail
    ROW="$(just _secrets-row "{{alias}}")" || exit 1
    IFS='|' read -r _ KEY _ _ <<< "${ROW}"
    OUT="$(just _secrets-paths "${KEY}")" || exit 1
    mapfile -t LINES <<< "${OUT}"
    REL="${LINES[1]:-}"
    [[ -n "${REL}" ]] || { echo "Error: _secrets-paths returned incomplete data for '${KEY}'" >&2; exit 1; }
    TARGET="{{SECRETS_CHIPR_PATH}}/${REL}.yaml"
    [[ -f "${TARGET}" ]] || { echo "Error: \"${TARGET}\" does not exist yet — create it first: just secret-set {{alias}}" >&2; exit 1; }
    exec sops edit "${TARGET}"

# Destroy a single encrypted secret blob (granular). The shared.nix
# declaration is config-layer truth — remove it separately when retiring
# the secret for good.
[group('secrets')]
secret-remove alias:
    #!/usr/bin/env bash
    set -euo pipefail
    ROW="$(just _secrets-row "{{alias}}")" || exit 1
    IFS='|' read -r _ KEY _ _ <<< "${ROW}"
    OUT="$(just _secrets-paths "${KEY}")" || exit 1
    mapfile -t LINES <<< "${OUT}"
    REL="${LINES[1]:-}"
    [[ -n "${REL}" ]] || { echo "Error: _secrets-paths returned incomplete data for '${KEY}'" >&2; exit 1; }
    TARGET="{{SECRETS_CHIPR_PATH}}/${REL}.yaml"
    [[ -f "${TARGET}" ]] || { echo "Error: cannot destroy non-existent file \"${TARGET}\"" >&2; exit 100; }
    rm -- "${TARGET}"
    echo "Destroyed ${TARGET}"
    echo "Note: the shared.nix declaration of '${KEY}' is untouched —"
    echo "remove it there too if the secret is being retired (config-layer truth)."

# List every declared secret: alias × domain × encrypted state — the
# "what exists and what is missing" answer before secret-set-all.
[group('secrets')]
secrets-list:
    #!/usr/bin/env bash
    set -euo pipefail
    printf '%-12s %-5s %-6s %s\n' "ALIAS" "DOM" "STATE" "SECRET"
    while IFS='|' read -r ALIAS KEY _ _; do
        OUT="$(just _secrets-paths "${KEY}")" || exit 1
        mapfile -t LINES <<< "${OUT}"
        REL="${LINES[1]:-}"
        TARGET="{{SECRETS_CHIPR_PATH}}/${REL}.yaml"
        if [[ -f "${TARGET}" ]]; then
            STATE="set"
        else
            STATE="MISSING"
        fi
        case "${KEY}" in *.srv.*) DOM="srv";; *) DOM="base";; esac
        printf '%-12s %-5s %-6s %s\n' "${ALIAS}" "${DOM}" "${STATE}" "${KEY}"
    done < <(just _secrets-registry)
    echo
    CONFIG="{{DOT_SOPS_FILENAME}}"
    if [[ -f "${CONFIG}" ]]; then
        echo "rules : ${CONFIG} present ($(grep -cE '^[[:space:]]*-[[:space:]]*&' "${CONFIG}") key(s) in the hierarchy)"
    else
        echo "rules : no ${CONFIG} yet (EMPTY state) → just secrets-init"
    fi
    if [[ -f "{{SECRETS_KEYFILE}}" ]]; then
        echo "keys  : local identities in {{SECRETS_KEYFILE}}:"
        age-keygen -y "{{SECRETS_KEYFILE}}" | nl
    else
        echo "keys  : no local key file yet → just secrets-init"
    fi
    echo "next  : just secret-set-all · just secrets-verify · just secrets-guide"


# ==============================================================================
# ROTATE LAYER — hierarchy consistency + re-encryption (lifecycle verbs)
# ==============================================================================
# Thin wrappers over scripts/sh/secrets-rotate.sh. That script executes the
# .sops.yaml creation_rules AS DATA (parse → IR → first-match dispatch):
# zero domain knowledge is hardcoded on this side of the boundary.

# Verify every secrets/**.yaml matches the .sops.yaml key hierarchy: rule
# coverage (NO-RULE = plaintext risk) + recipient equality (DRIFT).
# Wired into the CI security job.
[group('secrets')]
secrets-verify:
    @bash "{{ROOT}}/scripts/sh/secrets-rotate.sh" check

# Re-encrypt every blob onto the current .sops.yaml rules (sops updatekeys).
# The migration step after key-add-host / rotations / revocations.
[group('secrets')]
secrets-sync:
    @bash "{{ROOT}}/scripts/sh/secrets-rotate.sh" update

# Guided USER key rotation: replace in rules → sync → accept git history
# exposure (or rewrite it — see docs/secrets/rotation.md §compromise).
[group('keys')]
key-rotate-user pubkey:
    @bash "{{ROOT}}/scripts/sh/secrets-rotate.sh" rotate user "{{pubkey}}"

# Guided HOST key rotation: add-then-revoke, no unencrypted window.
[group('keys')]
key-rotate-host pubkey:
    @bash "{{ROOT}}/scripts/sh/secrets-rotate.sh" rotate host "{{pubkey}}"


# ==============================================================================
# STATUS — one-screen audit before any lifecycle decision
# ==============================================================================

# Keys, dispatch rules, blob count and a hierarchy check — the "look
# before you leap" entry point for every rotation decision.
[group('secrets')]
secrets-status:
    #!/usr/bin/env bash
    set -euo pipefail
    CONFIG="{{DOT_SOPS_FILENAME}}"
    if [[ ! -f "${CONFIG}" ]]; then
        echo "${CONFIG} missing — EMPTY lifecycle state."
        echo "Bootstrap: just secrets-init   (map: just secrets-guide)"
        exit 0
    fi
    echo "═══ keys (alias carries the domain: user_* / host_*) ═══"
    grep -E '^[[:space:]]*-[[:space:]]*&' "${CONFIG}" | sed 's/^[[:space:]]*-[[:space:]]*//'
    echo
    echo "═══ local identities (what THIS machine's key file holds) ═══"
    if [[ -f "{{SECRETS_KEYFILE}}" ]]; then
        age-keygen -y "{{SECRETS_KEYFILE}}" | nl
        echo "  → an identity whose pubkey appears above in keys: is a working"
        echo "    local decryptor for its domain(s); extra identities are inert"
        echo "    (not recipients of any rule) and harmless."
    else
        echo "  no key file yet (run: just secrets-init)"
    fi
    echo
    echo "═══ creation_rules (dispatch layer, first match wins) ═══"
    grep -E '^[[:space:]]*-[[:space:]]*path_regex:' "${CONFIG}" | sed 's/^[[:space:]]*-[[:space:]]*//'
    echo
    echo "═══ blobs ═══"
    N=$(find "{{SECRETS_CHIPR_PATH}}" -name '*.yaml' 2>/dev/null | wc -l)
    echo "encrypted (chipr): ${N} file(s)"
    if [[ -d "{{SECRETS_PLAN_PATH}}" ]]; then
        P=$(find "{{SECRETS_PLAN_PATH}}" -name '*.yaml' 2>/dev/null | wc -l)
        echo "plaintext instances (plan): ${P} file(s) — local only, never commit"
    fi
    echo
    echo "═══ hierarchy check ═══"
    just secrets-verify


# ==============================================================================
# Global destroy (granular)
# ==============================================================================

# Destroy all sops artifacts: plaintext instances + blobs + rules + the
# user key file (irreversible).
[group('secrets')]
secrets-destroy-all:
    @just secrets-plan-destroy
    @rm -rf {{SECRETS_CHIPR_PATH}}
    @echo "Destroyed {{SECRETS_CHIPR_PATH}}"
    @just rules-destroy
    @just key-destroy
    @echo "All sops artifacts destroyed."


# ==============================================================================
# Private — the secret registry (alias table, DATA)
# ==============================================================================
# The registry lives in secrets/registry.toml (DATA, committed). This
# recipe emits the pipe format the cipher-layer verbs consume:
#   alias | dotted-key in shared.nix | prompt (shown while typing) | transform
#   transform: "plain" (default — store as-is) | "mkpasswd" (sha-512 hash)
# Aliases are the short names every public verb takes. CRUD happens
# through secrets-add / secrets-edit / secrets-remove; the database
# cache (secrets/.cache/secrets.db) is refreshed transparently.

[private]
_secrets-registry:
    @python3 "{{ROOT}}/scripts/sh/secrets-db.py" q rows

# Resolve one registry row by alias; prints "alias|key|prompt|transform".
# Exits non-zero with the known-alias list when the alias is unknown.
[private]
_secrets-row alias:
    #!/usr/bin/env bash
    set -euo pipefail
    ROW="$(python3 "{{ROOT}}/scripts/sh/secrets-db.py" q row {{quote(alias)}})" || exit 1
    printf '%s\n' "${ROW}"


# ==============================================================================
# Private helpers — shared.nix parsing (single source of truth)
# ==============================================================================

# Print the username parsed from shared.nix (single source of truth).
# Exits non-zero with a clear message if shared.nix is missing or the username
# cannot be parsed. Every recipe that needs U (and not full paths) goes here.
[private]
_secrets-username:
    #!/usr/bin/env bash
    set -euo pipefail
    SHARED="{{SHARED_NIX_PATH}}"
    [[ -f "${SHARED}" ]] || { echo "Error: ${SHARED} not found. Run: just shared-generate <username>" >&2; exit 1; }
    U=$(grep -oP 'username\s*=\s*"\K[^"]+' "${SHARED}" || true)
    [[ -n "${U}" ]] || { echo "Error: could not parse username from ${SHARED}" >&2; exit 1; }
    printf '%s\n' "${U}"


# Canonical secret-path resolver — the ONLY place that maps a dotted key in
# shared.nix to concrete filesystem locations. Emits three lines to stdout:
#   line 1: absolute template file path   (TMPL — uses __USERNAME__ placeholder)
#   line 2: resolved secret rel-path      (REL  — real username substituted)
#   line 3: username value                (U    — for in-content substitution)
#
# R27: the grep/perl resolution moved into scripts/sh/secrets-db.py (one
# python implementation parses both declaration shapes and caches the
# join in the sqlite database) — same contract, same output, same
# canonical substitution rule. This recipe stays the single just-side
# entry point so every consumer is unchanged.
#
# Usage: just _secrets-paths "nixos.core.srv.db.redis.user.password"
[private]
_secrets-paths key:
    @python3 "{{ROOT}}/scripts/sh/secrets-db.py" q paths {{quote(key)}}


# ==============================================================================
# Private — infrastructure setup
# ==============================================================================

# Create all secret dirs (plan/ and chipr/) driven entirely by shared.nix
# declarations — resolved + cached in the database, emitted NUL-separated
# (injection-safe for any future exotic segment). Zero hardcoded paths.
[private]
_secrets-mkdir:
    #!/usr/bin/env bash
    set -euo pipefail
    SHARED="{{SHARED_NIX_PATH}}"
    [[ -f "${SHARED}" ]] || { echo "Error: ${SHARED} not found. Run: just shared-generate <username>" >&2; exit 1; }
    python3 "{{ROOT}}/scripts/sh/secrets-db.py" q dirs | while IFS= read -rd '' d; do
        mkdir -p "${d}"
    done
    echo "Created declaration dirs under secrets/plan and secrets/chipr"

# Generate the user age keypair if the key file does not exist yet
# (~/.config/sops/age/keys.txt, chmod 400 — never inside the repo).
[private]
_secrets-keygen:
    #!/usr/bin/env bash
    set -euo pipefail
    mkdir -p "{{SECRETS_KEYS_PATH}}"
    if [[ ! -f "{{SECRETS_KEYFILE}}" ]]; then
        age-keygen -o "{{SECRETS_KEYFILE}}" 2>/dev/null
        chmod 400 "{{SECRETS_KEYFILE}}"
        echo "Generated new age key at {{SECRETS_KEYFILE}}"
        echo "BACK IT UP — it is the only key that decrypts your personal"
        echo "secrets on a fresh machine (see docs/secrets/rotation.md)."
    else
        echo "Age key already exists at {{SECRETS_KEYFILE}}, skipping."
    fi

# Generate .sops.yaml from the bootstrap baseline template (tmpl → sed →
# guarded overwrite). Existence-guarded: when DEST already exists the recipe
# is a no-op UNLESS force="true" — the live file is the policy truth (host
# keys, rotations) and regeneration would reset the hierarchy to user-only.
# (rules-init / rules-reset are the public refusing / resetting variants
# of this guard.)
#
# Render mode is decided by the host material (the template carries the
# user key plus host placeholder lines — exactly one of these renders):
#   host_alias=""               user-only baseline (host lines stripped)
#   host_alias+host_pubkey      direct dual-key bootstrap (EMPTY → USER+HOST)
#                               e.g. just _secrets-write-rules false chipr age1…
#
# The user pubkey is pinned to the FIRST identity of the local key file —
# own-host machines legitimately carry extra identities after it.
[private]
_secrets-write-rules force="false" host_alias="" host_pubkey="":
    #!/usr/bin/env bash
    set -euo pipefail
    DEST="{{DOT_SOPS_FILENAME}}"
    if [[ -f "${DEST}" && "{{force}}" != "true" ]]; then
        echo "Skip: ${DEST} already exists — key evolution goes through the"
        echo "lifecycle verbs (just secrets-guide), not regeneration."
        exit 0
    fi
    if [[ -f "${DEST}" ]]; then
        echo "Warning: overwriting ${DEST} — resets the hierarchy to the"
        echo "baseline (host keys and rotations are lost)."
    fi
    U=$(just _secrets-username) || exit 1
    # Multi-identity key files are the own-host NORM (key-install-host
    # merges host identities into the same file), and `age-keygen -y`
    # then prints one pubkey PER identity — multi-line output. A newline
    # inside the s||| scripts below splits the sed expression
    # ("unterminated 's' command"), so pin the USER key: the FIRST
    # identity, the one _secrets-keygen created the file with
    # (key-install-host only ever appends after it).
    PUB=$(age-keygen -y "{{SECRETS_KEYFILE}}" | head -n 1)
    [[ "${PUB}" =~ ^age1[0-9a-z]+$ ]] || { echo "Error: no valid user public key (age1…) in {{SECRETS_KEYFILE}}" >&2; exit 1; }
    TMPL="{{SECRETS_TMPL_PATH}}/sops-rules.yaml.tmpl"
    [[ -f "${TMPL}" ]] || { echo "Error: sops rules template not found: ${TMPL}" >&2; exit 1; }
    DUAL=false
    HOST_SED=()
    if [[ -n "{{host_alias}}" || -n "{{host_pubkey}}" ]]; then
        A="{{host_alias}}"
        [[ "${A}" =~ ^[a-z0-9][a-z0-9_-]*$ ]] || { echo "Error: host alias must match [a-z0-9][a-z0-9_-]* (got '${A}')" >&2; exit 1; }
        [[ "{{host_pubkey}}" =~ ^age1[0-9a-z]+$ ]] || { echo "Error: host pubkey must be an age1… public key (got '{{host_pubkey}}')" >&2; exit 1; }
        DUAL=true
        HOST_SED=(-e "s|__HOST_ALIAS__|${A}|g" -e "s|__HOST_AGE_PUBLIC_KEY__|{{host_pubkey}}|g")
    fi
    sed \
        -e "s|__USERNAME__|${U}|g" \
        -e "s|__AGE_PUBLIC_KEY__|${PUB}|g" \
        ${HOST_SED[@]+"${HOST_SED[@]}"} \
        -e "/__HOST/d" \
        "${TMPL}" > "${DEST}"
    if ${DUAL}; then
        echo "Written ${DEST} (dual-key baseline: user + host_{{host_alias}}) for '${U}'"
        echo "  user key : ${PUB}"
        echo "  host key : {{host_pubkey}}"
        echo "Next: just secret-set-all   # srv blobs land dual-recipient"
    else
        echo "Written ${DEST} (user-only baseline) for '${U}'"
        echo "  user key : ${PUB}"
        echo "Next: just secrets-guide"
    fi


# ==============================================================================
# Private — plan plaintext instance generator
# ==============================================================================
# Generate one plaintext secret instance.
# Path resolution delegated to _secrets-paths (canonical rule). No inline grep.
#
# Usage:   just _secrets-plan-gen "nixos.core.srv.db.mongodb.user.password"
[private]
_secrets-plan-gen key:
    #!/usr/bin/env bash
    set -euo pipefail
    OUT=$(just _secrets-paths "{{key}}") || exit 1
    mapfile -t LINES <<< "${OUT}"
    TMPL="${LINES[0]:-}"
    REL="${LINES[1]:-}"
    U="${LINES[2]:-}"
    [[ -n "${TMPL}" && -n "${REL}" && -n "${U}" ]] || { echo "Error: _secrets-paths returned incomplete data for '{{key}}'" >&2; exit 1; }
    DEST="{{SECRETS_PLAN_PATH}}/${REL}.yaml"
    [[ -f "${TMPL}" ]] || { echo "Error: template not found: ${TMPL}" >&2; exit 1; }
    mkdir -p "$(dirname "${DEST}")"
    sed "s|__USERNAME__|${U}|g" "${TMPL}" > "${DEST}"
    echo "Generated plan: ${DEST}"


# ==============================================================================
# Private — chipr decrypt reader
# ==============================================================================
# Decrypt a secret by dotted key (path resolved at runtime via _secrets-paths).
# Usage:  just _secrets-decrypt "nixos.core.srv.db.mongodb.user.password"
[private]
_secrets-decrypt key:
    #!/usr/bin/env bash
    set -euo pipefail
    OUT=$(just _secrets-paths "{{key}}") || exit 1
    mapfile -t LINES <<< "${OUT}"
    REL="${LINES[1]:-}"
    [[ -n "${REL}" ]] || { echo "Error: _secrets-paths returned incomplete data for '{{key}}'" >&2; exit 1; }
    TARGET="{{SECRETS_CHIPR_PATH}}/${REL}.yaml"
    [[ -f "${TARGET}" ]] || { echo "Error: cannot operate on non-existent file \"${TARGET}\"" >&2; echo "  create it first: just secrets-list   (find the alias) → just secret-set <alias>" >&2; exit 100; }
    sops decrypt "${TARGET}"


# ==============================================================================
# Private — generic chipr encrypt writer
# ==============================================================================
# Single implementation for all secret encryption. Eliminates per-secret
# duplication. Path resolution via _secrets-paths (same canonical rule as
# plan). The placeholder is the single __SECRET_VALUE__ convention.
#
# Usage:   just _secrets-encrypt <key> <prompt> [transform]
#   key:         dotted key in shared.nix — used to resolve REL and derive TMPL
#   prompt:      label shown before password entry (no trailing ": ")
#   transform:   "plain" (default) — store value as-is
#                "mkpasswd"        — hash via mkpasswd -m sha-512 before storing
#
# Execution flow:
#   1. Resolve TMPL/REL/U from shared.nix via _secrets-paths (canonical rule)
#   2. Read secret interactively (hidden, confirmed); apply optional transform
#   3. sed substitute __USERNAME__, then __SECRET_VALUE__ in template
#   4. Pipe through sops encrypt → SECRETS_CHIPR_PATH/REL.yaml (atomic mv)
#
# To add a new secret type: no changes here. Add to shared.nix.tmpl + template
# file + one _secrets-registry row.
[private]
_secrets-encrypt key prompt transform="plain":
    #!/usr/bin/env bash
    set -euo pipefail
    OUT=$(just _secrets-paths "{{key}}") || exit 1
    mapfile -t LINES <<< "${OUT}"
    TMPL="${LINES[0]:-}"
    REL="${LINES[1]:-}"
    U="${LINES[2]:-}"
    [[ -n "${TMPL}" && -n "${REL}" && -n "${U}" ]] || { echo "Error: _secrets-paths returned incomplete data for '{{key}}'" >&2; exit 1; }
    DEST="{{SECRETS_CHIPR_PATH}}/${REL}.yaml"
    [[ -f "${TMPL}" ]] || { echo "Error: template not found: ${TMPL}" >&2; exit 1; }

    # 1. Read secret interactively (hidden input, with confirmation).
    echo -n "{{prompt}}: "; read -rs secret; echo
    echo -n "Confirm: ";    read -rs csecret; echo
    if [[ "${secret}" != "${csecret}" ]]; then
        unset -v secret csecret
        echo "Error: confirmation mismatch" >&2; exit 1
    fi
    unset -v csecret

    # 2. Apply optional transform; clear plaintext immediately after.
    #    Existence is checked BEFORE the interactive read: failing after
    #    the password is typed (bare "command not found" from bash) wastes
    #    the operator's input and hides the remedy (the whois package).
    if [[ "{{transform}}" == "mkpasswd" ]]; then
        command -v mkpasswd >/dev/null 2>&1 || { echo "Error: mkpasswd not found — install the 'whois' package first" >&2; exit 1; }
    fi
    value="${secret}"
    unset -v secret
    if [[ "{{transform}}" == "mkpasswd" ]]; then
        value=$(printf '%s' "${value}" | mkpasswd -m sha-512 -R 5000 -s)
    fi

    # 3. Substitute __USERNAME__, then the secret placeholder.
    #    awk via ENVIRON is used for the placeholder substitution instead of sed
    #    so that arbitrary characters in the secret value (|, \, &, newlines, …)
    #    are treated as literals and never interpreted as sed metacharacters.
    #    Atomic write: encrypt to a temp file first, then mv into place so that
    #    a sops failure never leaves the destination file truncated or corrupt.
    mkdir -p "$(dirname "${DEST}")"
    TMPOUT=$(mktemp "${DEST}.XXXXXX")
    export _SOPS_VAL="${value}"
    unset -v value
    sed "s|__USERNAME__|${U}|g" "${TMPL}" \
        | awk -v old="__SECRET_VALUE__" '
            BEGIN { new = ENVIRON["_SOPS_VAL"] }
            {
                out = ""; s = $0
                while ((idx = index(s, old)) > 0) {
                    out = out substr(s, 1, idx-1) new
                    s = substr(s, idx+length(old))
                }
                print out s
            }' \
        | sops encrypt --input-type yaml --filename-override "${DEST}" /dev/stdin \
        > "${TMPOUT}"
    unset -v _SOPS_VAL
    mv -f "${TMPOUT}" "${DEST}"
    echo "OK: ${DEST}"
