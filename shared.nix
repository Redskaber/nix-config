# @path: ~/projects/configs/nix-config/docs/tmpl/shared.nix.tmpl
# @author: redskaber
# @description: self::shared — fleet base policy (template → live instance)
#
# NOTE: repo-root shared.nix is the LIVE fleet base policy (loaded by
#       lib/shared/default.nix via scfpath). It is generated from this
#       template: `just shared-generate <username>` renders it, and
#       `just shared-roundtrip` gates regeneration as byte-identical.
#       Edit the template, not the output.
#
# Three-layer policy chain (fleet → role → host):
#
#   THIS file       the fleet layer — identity, shared constants,
#                   majority defaults, and the `roles` registry (the
#                   management plane: one row per host).
#   enum.nix `role` the role layer — form strategy bundles selected
#                   by the registry row (composition over override).
#   hosts/<h>/      the host layer — class + hardware + whatever the
#     shared.nix    machine says about itself; wins over any role key.
#
# The merge is controlled (lib/shared/default.nix): role rows carry
# strategy keys only (Law F whitelist), hostName is force-aligned to
# the directory loaded, and `shared.why.<key>` reports which layer
# won every key.
#
# Single source of truth:
#   username appears only here; propagated to shared.nix via generation,
#   never via sed in-place patch (mutation breaks declarative invariant).

{ shared, inputs, ... }:
let
  username = "kilig";
in
shared.schema.fleet {
  arch = shared.enum.arch.x86_64-linux;
  drive = shared.enum.drive-group.intel;
  sound = shared.enum.sound.pipewire;
  pointer-cursor = shared.enum.pointer-cursor.Bibata-Modern-Classic;
  version = shared.enum.version.v26_05;
  editor = shared.enum.editor.nvim;
  devDir = "${shared.self}/home/env/dev";
  hostName = "nixos";
  roles = {
    nixos = shared.enum.role.workstation;
    vm = shared.enum.role.server;
    wsl = shared.enum.role.console;
    nixos-wsl = shared.enum.role.console;
    darwin = shared.enum.role.laptop;
  };

  user = {
    inherit username;
    shell = shared.enum.shell.zsh;
    openssh-authKeys = [ ];
  };

  git = {
    defaultBranch = "main";
    name = "redskaber";
    email = "redskaber@foxmail.com";
    lazygit.name = "lg";
  };

  rbw = {
    email = "alexredskaber@gmail.com";
    lock_timeout = 600;
  };

  time = {
    used-ip-timeZone = false;
    timeZone = "Asia/Shanghai";
  };

  i18n = {
    defaultLocale = "en_US.UTF-8";
    extraLocalSetting = "zh_CN.UTF-8";
    extraLocales = [ "zh_CN.UTF-8/UTF-8" ];
  };

  # Network config (incus bridge, etc.)
  # IPv6 address generated by `openssl rand -hex 8`
  network = {
    incusIPv6 = "fd42:8bdd:fa83:9703:95b2::1/64";
  };

  # sops age key paths derived from username (secrets paths follow username)
  secrets = {
    sshKeyPaths = [ "/home/${username}/.ssh/id_ed25519_github" ];
    nixos.core.base.user.password = "nixos/core/base/user/${username}/password";
    nixos.core.base.nix.user.github.access-token =
      "nixos/core/base/nix/users/${username}/github/access-token";
    nixos.core.srv.db.mongodb.user.password = "nixos/core/srv/db/mongodb/users/${username}/password";
    nixos.core.srv.db.mysql.root.password = "nixos/core/srv/db/mysql/users/root/password";
    nixos.core.srv.db.mysql.user.password = "nixos/core/srv/db/mysql/users/${username}/password";
    nixos.core.srv.db.postgresql.user.password =
      "nixos/core/srv/db/postgresql/users/${username}/password";
    nixos.core.srv.db.redis.user.password = "nixos/core/srv/db/redis/users/redis-${username}/password";
    nixos.core.base.nix.cachix.auth-token = "nixos/core/base/nix/cachix/auth-token";
  };

  nixpkgs = {
    # You can add overlays here
    overlays = [
      # Add overlays your own flake exports (from overlays and pkgs dir):
      # or `inputs.self.overlays.additions`
      shared.self.overlays.additions
      shared.self.overlays.patches

      # You can also add overlays exported from other flakes:
      # neovim-nightly-overlay.overlays.default

      # Or define it inline, for example:
      # (final: prev: {
      #   helloworld-patched = final.helloworld.overrideAttrs (oldAttrs: {
      #     patches = [ ./helloworld-to-helloworld.patch ];
      #   });
      # })
    ];
    # Configure your nixpkgs instance
    config = {
      # Disable if you don't want unfree packages
      allowUnfree = true;
      # Unsafe pkgs
      permittedInsecurePackages = [
        "python3.12-ecdsa-0.19.1" # python-renpy
        "electron-41.10.7"
      ];
    };
  };
}
