# @path: ~/projects/configs/nix-config/hosts/nixos/default.nix
# @author: redskaber
# @datetime: 2026-03-15
# @description: hosts::nixos — host-specific configuration override
#
# Migration: this host is the LAST on the legacy hardware.nix fact
# source. `just hardware-migrate` — run ON this machine — flips it to
# the declarative facter report in one command; the end state is
# locked by the fact-source census (tests/lib/shared/targets.nix):
# exactly one source per bare-metal host — never both, never neither.
#
# Multi-host layout: hosts/<hostname>/default.nix (host entry: imports
# hardware.nix + overrides), hosts/<hostname>/hardware.nix (auto-
# generated by nixos-generate-config), optional shared.nix (host policy
# overrides). To add a host: mkdir hosts/<name>, copy this file,
# generate hardware.nix, (optionally) write shared.nix — available as
# nixosConfigurations.<name> / <user>@<name> (no flake.nix edit:
# hosts/ is enumerated).

{ ... }:

{
  imports = [
    ./hardware.nix
  ];

  # Machine fingerprints (sunk from nixos/core/drive/nvidia-prime.nix):
  # the generic drive layer must stay hardware-agnostic.
  hardware.nvidia.prime = {
    intelBusId = "PCI:0:2:0"; # 00:02.0
    nvidiaBusId = "PCI:6:0:0"; # 06:00.0
  };
}
